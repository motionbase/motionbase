{{!
    This file is part of the MotionBase plugin for Moodle.
}}
{{!
    @template filter_motionbase/picker

    "Add from MotionBase": everything MotionBase offers, as checkboxes, with
    the section it goes into and one button.

    Example context (json):
    {
        "action": "https://moodle.example/filter/motionbase/add.php",
        "courseid": 2,
        "sesskey": "abc",
        "sections": [{"num": 0, "name": "Allgemeines", "selected": true}],
        "cancelurl": "https://moodle.example/course/view.php?id=2",
        "error": null,
        "empty": false,
        "topics": [{
            "id": 1, "title": "Easing", "meta": "4 Lektionen", "hastasks": true,
            "tasks": [{"value": "task:7", "name": "Bubblesort", "meta": "Aufgabe · Abgabe als Datei · Grundlagen", "label": "Bubblesort", "search": "bubblesort", "present": false}],
            "whole": {"value": "topic:1", "name": "Ganzer Kurs", "meta": "Alle Kapitel", "label": "Easing", "search": "easing", "present": false},
            "chapters": [{"value": "chapter:3", "name": "Grundlagen", "meta": "Kapitel · 4 Lektionen", "label": "Easing – Grundlagen", "search": "easing grundlagen", "present": true, "haslessons": false, "lessons": []}],
            "assistant": {"value": "chat:1", "name": "KI-Assistent", "meta": "Beantwortet Fragen", "label": "Easing – KI-Assistent", "search": "easing ki", "present": false}
        }]
    }
}}
<form method="post" action="{{action}}" class="mbpicker" id="mbpicker-picker">
    <input type="hidden" name="course" value="{{courseid}}">
    <input type="hidden" name="sesskey" value="{{sesskey}}">

    <h2 class="h3 mb-2">{{#str}} addfrommotionbase, filter_motionbase {{/str}}</h2>
    <p class="mbpicker__intro">{{#str}} intro, filter_motionbase {{/str}}</p>

    {{#error}}
        <div class="alert alert-warning" role="alert">{{error}}</div>
    {{/error}}

    {{^error}}
    <div class="mbpicker__tools">
        <div class="mbpicker__target">
            <label for="mbpicker-target">{{#str}} target, filter_motionbase {{/str}}</label>
            <select id="mbpicker-target" name="target" class="form-select custom-select">
                {{#sections}}
                    <option value="{{num}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                {{/sections}}
            </select>
        </div>
        {{^empty}}
        <div class="mbpicker__search">
            <label for="mbpicker-search" class="visually-hidden sr-only">{{#str}} search {{/str}}</label>
            <input type="search" id="mbpicker-search" class="form-control" placeholder="{{#str}} search, filter_motionbase {{/str}}" autocomplete="off" data-search-input>
        </div>
        {{/empty}}
    </div>
    {{/error}}

    {{#empty}}
        <div class="mbpicker__empty">
            <p class="fw-bold font-weight-bold mb-1">{{#str}} empty, filter_motionbase {{/str}}</p>
            <p class="text-muted mb-0">{{#str}} emptyhint, filter_motionbase {{/str}}</p>
        </div>
    {{/empty}}

    {{#topics}}
        <section class="mbpicker-topic" data-topic>
            <header class="mbpicker-topic__head">
                <h3 class="h5 mb-0">{{title}}</h3>
                <span class="text-muted small">{{meta}}</span>
            </header>

            {{#hastasks}}
                <div class="mbpicker-group" data-group>
                    <h4 class="mbpicker-group__title">{{#str}} tasks, filter_motionbase {{/str}} <span>{{#str}} tasksintro, filter_motionbase {{/str}}</span></h4>
                    {{#tasks}}{{> filter_motionbase/option }}{{/tasks}}
                </div>
            {{/hastasks}}

            <div class="mbpicker-group" data-group>
                <h4 class="mbpicker-group__title">{{#str}} content, filter_motionbase {{/str}}</h4>
                {{#whole}}{{> filter_motionbase/option }}{{/whole}}
                {{#chapters}}
                    <div data-chapter>
                        {{> filter_motionbase/option }}
                        {{#haslessons}}
                            <details class="mbpicker-lessons">
                                <summary>{{#str}} showlessons, filter_motionbase {{/str}}</summary>
                                {{#lessons}}{{> filter_motionbase/option }}{{/lessons}}
                            </details>
                        {{/haslessons}}
                    </div>
                {{/chapters}}
                {{#assistant}}{{> filter_motionbase/option }}{{/assistant}}
            </div>
        </section>
    {{/topics}}

    <div class="mbpicker__empty" data-nomatch hidden>
        <p class="fw-bold font-weight-bold mb-1">{{#str}} nomatch, filter_motionbase {{/str}}</p>
        <p class="text-muted mb-0">{{#str}} nomatchhint, filter_motionbase {{/str}}</p>
    </div>

    <div class="mbpicker__bar">
        <span class="mbpicker__count" data-count aria-live="polite">{{#str}} selectednone, filter_motionbase {{/str}}</span>
        <a href="{{cancelurl}}" class="btn btn-secondary">{{#str}} cancel {{/str}}</a>
        {{^error}}
            <button type="submit" class="btn btn-primary" data-submit disabled>{{#str}} add, filter_motionbase {{/str}}</button>
        {{/error}}
    </div>
</form>
